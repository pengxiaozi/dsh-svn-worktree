{
  "name": "dsh-svn-worktree",
  "version": "0.1.1",
  "description": "SVN branch worktrees and a change panel for DeepSeek Harness",
  "type": "module",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "svn",
    "subversion",
    "worktree",
    "branch",
    "sidebar"
  ],
  "license": "MIT",
  "author": "pengxiaozi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pengxiaozi/dsh-svn-worktree.git"
  },
  "homepage": "https://github.com/pengxiaozi/dsh-svn-worktree#readme",
  "bugs": {
    "url": "https://github.com/pengxiaozi/dsh-svn-worktree/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "icon": "./icon.svg",
  "files": [
    "lib",
    "client",
    "locale",
    "docs",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node test/host.test.mjs && node test/client.test.mjs",
    "test:real": "node test/check-real-copy.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
